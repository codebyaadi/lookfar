{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": [".svelte-kit/**", "build/**"]
}
