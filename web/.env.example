# Copy to .env (SvelteKit loads it in dev).
DATABASE_URL=postgres://lookfar:lookfar@localhost:5432/lookfar?sslmode=disable
# Must be identical to BETTER_AUTH_SECRET in the root .env.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
API_URL=http://localhost:8080
# The first account is always allowed; set true to keep sign-up open after that.
ALLOW_SIGNUP=false
