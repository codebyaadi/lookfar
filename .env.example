# Copy to .env (Go services) — www/ has its own .env.example.
APP_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://feedoku:feedoku@localhost:5432/feedoku?sslmode=disable

# API
API_ADDR=:8080
CORS_ORIGINS=http://localhost:3000
# Must be identical to BETTER_AUTH_SECRET in www/.env.local.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Worker
WORKER_TICK=30s

# AI providers (used from Phase 2)
GROQ_API_KEY=
OPENROUTER_API_KEY=
VOYAGE_API_KEY=
