# Copy to .env (Go services) — web/ has its own .env.example.
APP_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://lookfar:lookfar@localhost:5432/lookfar?sslmode=disable

# API
API_ADDR=:8080
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used by docker compose for the web service).
BETTER_AUTH_URL=http://localhost:3000
# Must be identical to BETTER_AUTH_SECRET in web/.env.local.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional GitHub token (no scopes needed) to raise the API rate limit for release sources.
GITHUB_TOKEN=

# Worker
WORKER_TICK=30s
# Source checks the worker runs at once.
CHECK_CONCURRENCY=4
# Allow fetching feeds from private/loopback addresses (local testing only).
ALLOW_PRIVATE_SOURCES=false

# Built-in free LLM chain (zero-config default). All optional; users can add their own keys in-app.
# Chat completions use OpenAI-compatible APIs, tried in order (Groq, then OpenRouter).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Requests per minute per provider (stay under your free-tier limit).
LLM_RPM=25
# Embeddings (1024 dimensions).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# Host port for the docker-compose Postgres (change if 5432 is taken, and update DATABASE_URL).
POSTGRES_PORT=5432
