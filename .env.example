# Copy to .env (Go services) — www/ has its own .env.example.
APP_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://feedoku:feedoku@localhost:5432/feedoku?sslmode=disable

# API
API_ADDR=:8080
CORS_ORIGINS=http://localhost:3000
# Must be identical to BETTER_AUTH_SECRET in www/.env.local.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Worker
WORKER_TICK=30s
# Allow fetching feeds from private/loopback addresses (local testing only).
ALLOW_PRIVATE_FEEDS=false

# AI providers. All optional: with no keys Feedoku runs as a plain reader and
# the worker skips summaries/embeddings.
# Chat completions use OpenAI-compatible APIs, tried in order (Groq, then OpenRouter).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Requests per minute per provider (stay under your free-tier limit).
LLM_RPM=25
# Concurrent enrichment jobs.
ENRICH_CONCURRENCY=2
# Embeddings (1024 dimensions). Free-tier keys have tight rate limits, so keep batches small.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
EMBED_BATCH=16

# Host port for the docker-compose Postgres (change if 5432 is taken, and update DATABASE_URL).
POSTGRES_PORT=5432
